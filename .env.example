# 이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)
# Netlify에서는 Site configuration → Environment variables 에 같은 이름으로 넣습니다.

# ── Firebase 웹 앱 설정 (빌드 때 public/js/firebase-config.js 로 주입) ──
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# ── 서버(Netlify Functions) 전용 비밀 값: 브라우저로 절대 전달하지 않음 ──
# Firebase 서비스 계정 JSON 을 base64 로 인코딩한 값
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Google AI Studio 에서 발급한 Gemini API 키
GEMINI_API_KEY=
# 채점에 쓸 Gemini 모델 이름 (구현 시 공식 문서에서 확인한 값)
GEMINI_MODEL=

# ── 교사 계정 (쉼표로 구분한 Google 이메일) ──
TEACHER_EMAILS=
