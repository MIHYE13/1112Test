rules_version = '2';
// 서술형 연습 웹앱 v2 보안 규칙
// 1단계: 교사 허용 목록, 반 만들기, 반 코드 참여(번호·모둠 직접 입력), 모둠 고치기
// 2단계: 답(마감 시각을 서버 시각으로 검사), 정답 키(공개 조건), 자기 점검
// 설계: develop.md 5장. 규칙을 바꾸면 tests/firestore.rules.test.mjs 도 함께 고칩니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/config/access)
        && request.auth.token.email in get(/databases/$(database)/documents/config/access).data.teacherEmails;
    }
    function classData(classId) { return get(/databases/$(database)/documents/classes/$(classId)).data; }
    function owns(classId) { return isTeacher() && classData(classId).ownerUid == request.auth.uid; }
    function isInt(v, lo, hi) { return v is int && v >= lo && v <= hi; }

    // 교사 허용 목록: 콘솔 또는 관리 도구로만 씀. 교사만 읽을 수 있음(교사 확인용)
    match /config/access {
      allow read: if isTeacher();
      allow write: if false;
    }

    // 정답 키 원본(교사만): 교사 화면에서 data/answer-keys.json 을 올림
    match /answerKeys/{qid} {
      allow read, write: if isTeacher();
    }

    // 반 코드 → 반 ID
    match /classCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isTeacher()
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['classId'])
        && request.resource.data.classId is string
        && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.code == code;
      allow update: if false;
      allow delete: if owns(resource.data.classId);
    }

    match /classes/{classId} {
      function classFieldsOk(d) {
        return d.keys().hasOnly(['ownerUid', 'name', 'code', 'studentCount', 'groupCount', 'createdAt',
                                 'mode', 'freeSeconds', 'revealPolicy', 'live', 'revealed', 'feedbackPublish'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
          && isInt(d.studentCount, 1, 40)
          && isInt(d.groupCount, 1, 6);
      }
      allow get: if signedIn();
      // 학생이 첫 화면에서 반을 고를 수 있도록 로그인한 사용자는 반 목록을 볼 수 있음(반 이름·진행 상태만 있고 개인정보 없음)
      allow list: if signedIn();
      allow create: if isTeacher()
        && request.resource.data.keys().hasAll(['ownerUid', 'name', 'code', 'studentCount', 'groupCount', 'createdAt'])
        && classFieldsOk(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/classCodes/$(request.resource.data.code))
        && getAfter(/databases/$(database)/documents/classCodes/$(request.resource.data.code)).data.classId == classId;
      allow update: if owns(classId)
        && classFieldsOk(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'code', 'createdAt']);
      allow delete: if owns(classId);

      // 번호 자리: 한 번호에는 한 학생만 (중복 참여 방지)
      match /numbers/{num} {
        allow get: if signedIn();
        allow list: if owns(classId);
        allow create: if signedIn()
          && num.matches('^[1-9][0-9]?$')
          && int(num) <= classData(classId).studentCount
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid
          && existsAfter(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid));
        allow update: if false;
        allow delete: if owns(classId);   // 기기가 바뀐 학생의 번호를 풀어 줄 때
      }

      // 참여한 학생: 이름은 저장하지 않음(develop.md 11장)
      match /students/{uid} {
        allow get: if (signedIn() && request.auth.uid == uid) || owns(classId);
        allow list: if owns(classId);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['number', 'group', 'joinedAt', 'lastSeen'])
          && isInt(request.resource.data.number, 1, classData(classId).studentCount)
          && isInt(request.resource.data.group, 1, classData(classId).groupCount)   // 학생이 참여할 때 자기 모둠을 고름
          && request.resource.data.joinedAt == request.time
          && request.resource.data.lastSeen == request.time
          && getAfter(/databases/$(database)/documents/classes/$(classId)/numbers/$(string(request.resource.data.number))).data.uid == uid;
        // 학생: 접속 시각만 / 교사: 모둠 고치기(0 = 미배정, 모둠 수를 줄였을 때)
        allow update: if (signedIn() && request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
              && request.resource.data.lastSeen == request.time)
          || (owns(classId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['group'])
              && isInt(request.resource.data.group, 0, classData(classId).groupCount));
        allow delete: if owns(classId);
      }

      // ---------- 2단계: 학생 답 ----------
      function me() { return get(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid)).data; }
      function isMember() { return signedIn() && exists(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid)); }
      function textOk(t, i) { return t.size() <= i || (t[i] is string && t[i].size() <= 2000); }
      function textsOk(t) { return t is list && t.size() <= 6 && textOk(t, 0) && textOk(t, 1) && textOk(t, 2) && textOk(t, 3) && textOk(t, 4) && textOk(t, 5); }
      // 마감 검사(5초 여유): 실시간 진행은 반의 live, 자유 연습은 답의 seconds 기준
      function liveOpenFor(c, qid) {
        return c.live != null && c.live.qid == qid
          && (c.live.closed == true
              ? request.time <= c.live.closedAt + duration.value(5, 's')
              : request.time <= c.live.startedAt + duration.value(c.live.seconds + 5, 's'));
      }
      function freeOpen(a) { return a.seconds == 0 || request.time <= a.startedAt + duration.value(a.seconds + 5, 's'); }
      function inTime(c, a) { return a.mode == 'live' ? liveOpenFor(c, a.qid) : freeOpen(a); }

      match /answers/{aid} {
        // 문서 ID 가 '내 uid_문항' 이면 아직 없는 문서도 구독 가능(시작 전부터 실시간 대기)
        allow get: if (signedIn() && aid.split('_')[0] == request.auth.uid) || owns(classId);
        allow list: if owns(classId);
        allow create: if isMember()
          && aid == request.auth.uid + '_' + request.resource.data.qid
          && request.resource.data.keys().hasOnly(['uid', 'number', 'group', 'qid', 'mode', 'seconds', 'texts', 'status', 'startedAt', 'updatedAt', 'submittedAt', 'self'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.number == me().number
          && request.resource.data.group == me().group
          && request.resource.data.qid in ['p1', 'p2', 'p3', 'p4', 'p5', 'p6', 'p7', 'p8']
          && textsOk(request.resource.data.texts)
          && request.resource.data.status == 'draft'
          && request.resource.data.startedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.submittedAt == null
          && request.resource.data.self == []
          && (
            (request.resource.data.mode == 'live' && classData(classId).mode == 'live'
              && classData(classId).live != null && classData(classId).live.closed == false
              && request.resource.data.seconds == 0
              && liveOpenFor(classData(classId), request.resource.data.qid))
            || (request.resource.data.mode == 'free' && classData(classId).mode == 'free'
              && request.resource.data.seconds == classData(classId).freeSeconds)
          );
        allow update: if
          // 학생: 작성 중 → 임시 저장 / 제출 / 시간 종료 (마감 안에서만)
          (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'draft'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texts', 'status', 'submittedAt', 'updatedAt'])
            && textsOk(request.resource.data.texts)
            && request.resource.data.updatedAt == request.time
            && inTime(classData(classId), resource.data)
            && (request.resource.data.status == 'draft'
                ? request.resource.data.submittedAt == null
                : (request.resource.data.status in ['submitted', 'timeout'] && request.resource.data.submittedAt == request.time)))
          // 학생: 제출 뒤에는 자기 점검 체크만
          || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status != 'draft'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['self'])
            && request.resource.data.self is list && request.resource.data.self.size() <= 20)
          // 교사: 마감 뒤 남은 작성 중 답을 시간 종료로 정리
          || (owns(classId) && resource.data.status == 'draft'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'submittedAt'])
            && request.resource.data.status == 'timeout' && request.resource.data.submittedAt == request.time);
        allow delete: if owns(classId);
      }

      // 반별 정답 키: 정답이 공개된 문항, 또는 '제출 즉시 공개' 반에서 자기 답을 낸 뒤에만 학생이 읽음
      match /keys/{qid} {
        allow get: if owns(classId)
          || (isMember() && (qid in classData(classId).revealed
              || (classData(classId).revealPolicy == 'submit'
                  && exists(/databases/$(database)/documents/classes/$(classId)/answers/$(request.auth.uid + '_' + qid))
                  && get(/databases/$(database)/documents/classes/$(classId)/answers/$(request.auth.uid + '_' + qid)).data.status != 'draft')));
        allow list: if owns(classId);
        allow write: if owns(classId);
      }
    }

    // 그 밖의 모든 문서는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
